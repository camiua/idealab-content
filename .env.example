# Plantilla de variables de entorno de IdeaLab Content.
# Copia este archivo como .env y rellena tus valores. El .env nunca se sube al repositorio.
# Referencia: .specify/1_spec.md §1.6

# ---------- LLM (nivel esencial) ----------
# Ollama en local. Si el backend corre en Docker, usa http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq en la nube. Clave gratuita en https://console.groq.com
GROQ_API_KEY=
# Comprueba en la consola de Groq que el modelo sigue disponible
GROQ_MODEL=llama-3.1-8b-instant

# Proveedor por defecto: ollama | groq
DEFAULT_PROVIDER=groq

# Origen permitido para el frontend (CORS)
CORS_ORIGINS=http://localhost:5173

# ---------- Imágenes (nivel medio) ----------
# Clave gratuita en https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ---------- Trazabilidad (nivel avanzado) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=idealab-content

# ---------- RAG (nivel avanzado) ----------
CHROMA_PATH=./data/chroma
